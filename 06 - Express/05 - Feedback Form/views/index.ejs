<!DOCTYPE html>
<html lang="en">
<head>
    <title>Feedback Form</title>
</head>
<body>
    <h1>Feedback Form</h1>

    <form action="/result" method="post">
        <label for="name">Your Name (optional):</label><br>
        <input type="text" id="name" name="name"><br><br>

        <label for="course">Course Title:</label><br>
        <select id="course" name="course">
            <% for (let i = 0; i < courses.length; i++) { %>
                <option value="<%= courses[i] %>"><%= courses[i] %></option>
            <% } %>
        </select><br><br>

        <label for="score">Given Score (1-10):</label><br>
        <select id="score" name="score">
            <% for (let i = 1; i <= 10; i++) { %>
                <option value="<%= i %>"><%= i %></option>
            <% } %>
        </select><br><br>

        <label for="reason">Reason:</label><br>
        <textarea id="reason" name="reason" rows="4" cols="40"></textarea><br><br>

        <input type="submit" value="Submit">
    </form>
</body>
</html>
