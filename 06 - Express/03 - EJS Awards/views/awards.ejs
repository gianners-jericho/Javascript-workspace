<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Achievements & Awards</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

    <header>
        <div class="logo">🏆 Achievements Hub</div>
        <nav>
            <a href="/awards" class="active">All Awards</a>
        </nav>
    </header>

    <div class="container">
        <h1>Featured Achievements</h1>
        <p class="subtitle">Click on any award to view detailed information and category breakdowns.</p>

        <div class="grid-container">
            <!-- Award Card 1: Oscar -->
            <a href="/awards/oscar" class="card-link">
                <div class="card">
                    <img src="/images/oscar.jpg" alt="Academy Award Poster">
                    <div class="card-info">
                        <h3>Academy Award</h3>
                        <p>Film Industry • 2024</p>
                    </div>
                </div>
            </a>

            <!-- Award Card 2: Grammy -->
            <a href="/awards/grammy" class="card-link">
                <div class="card">
                    <img src="/images/grammy.jpg" alt="Grammy Award Poster">
                    <div class="card-info">
                        <h3>Grammy Award</h3>
                        <p>Music Industry • 2024</p>
                    </div>
                </div>
            </a>

            <!-- Award Card 3: Cannes -->
            <a href="/awards/palme" class="card-link">
                <div class="card">
                    <img src="/images/palme.jpg" alt="Palme d'Or Poster">
                    <div class="card-info">
                        <h3>Palme d'Or</h3>
                        <p>International Film • 2026</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

</body>
</html>