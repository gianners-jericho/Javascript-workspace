<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Awards</title>

    <link rel="stylesheet" href="/styles/awards.css">
</head>

<body>

    <div class="awards-container">

        <h1>Featured Awards</h1>

        <p class="awards-subtitle">
            A celebration of excellence, achievement, and distinction
        </p>

        <div class="awards-grid">

            <a class="award-card" href="/awards/olympic-gold-medal">
                <img src="/images/olympic_gold.webp" alt="Olympic Gold Medal">

                <h2>Olympic Gold Medal</h2>

                <p>
                    The highest achievement in Olympic competition.
                </p>
            </a>

            <a class="award-card" href="/awards/nobel-peace-prize">
                <img src="/images/nobel_peace_award.webp" alt="Nobel Peace Prize">

                <h2>Nobel Peace Prize</h2>

                <p>
                    Recognizing outstanding contributions to peace.
                </p>
            </a>

            <a class="award-card" href="/awards/golden-globes">
                <img src="/images/golden_globes.webp" alt="Golden Globes">

                <h2>Golden Globes</h2>

                <p>
                    Celebrating excellence in film and television.
                </p>
            </a>

        </div>

    </div>

</body>
</html>