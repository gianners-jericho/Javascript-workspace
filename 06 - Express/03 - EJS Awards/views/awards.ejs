<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Awards</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f7f8fa;
      color: #1f2937;
      line-height: 1.5;
    }

    .container {
      width: min(1100px, 90%);
      margin: 0 auto;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      padding: 20px 0;
    }

    .header-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
      color: #111827;
    }

    nav a {
      margin-left: 20px;
      color: #6b7280;
      text-decoration: none;
    }

    nav a:hover {
      color: #111827;
    }

    .page-header {
      padding: 50px 0 30px;
    }

    .page-header h1 {
      font-size: 36px;
      margin-bottom: 8px;
    }

    .page-header p {
      color: #6b7280;
    }

    .awards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      padding-bottom: 50px;
    }

    .award-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 24px;
      transition: 0.2s ease;
    }

    .award-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    }

    .award-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #fff4cc;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 18px;
    }

    .award-card h2 {
      font-size: 20px;
      margin-bottom: 8px;
    }

    .award-year {
      color: #9a6700;
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 12px;
    }

    .award-card p {
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 18px;
    }

    .view-link {
      color: #2563eb;
      text-decoration: none;
      font-size: 14px;
      font-weight: bold;
    }

    @media (max-width: 800px) {
      .awards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 550px) {
      .awards-grid {
        grid-template-columns: 1fr;
      }

      .header-content {
        flex-direction: column;
        gap: 12px;
      }

      nav a {
        margin: 0 8px;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="container header-content">
      <div class="logo">Awards Portal</div>

      <nav>
        <a href="awards.html">Awards</a>
        <a href="#">About</a>
      </nav>
    </div>
  </header>

  <main class="container">

    <section class="page-header">
      <h1>Our Awards</h1>
      <p>Explore the awards and recognition we've received over the years.</p>
    </section>

    <section class="awards-grid">

        <% for (const i in awards) { %>
        <article class="award-card">
            <div class="award-icon"><%= awards[i].icon %></div>
            <div class="award-year"><%= awards[i].year %></div>
            <h2><%= awards[i].name %></h2>>
            <a class="view-link" href=" <%= awards[i].url %>">
            View details →
            </a>
        </article>
        <% } %>
    </section>

  </main>

</body>
</html>
