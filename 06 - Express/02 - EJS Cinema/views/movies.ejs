<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cinema - Movies</title>
    <style>
        body {
            font-family: sans-serif;
            text-align: center;
            margin: 0;
            padding: 20px;
        }
        nav {
            text-align: center;
            margin-top: 10px;
        }
        nav a {
            text-decoration: none;
            color: #0066cc;
        }
        nav a:hover {
            text-decoration: underline;
        }
        .movie-list {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 30px;
            margin: 30px auto;
        }
        .movie-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            width: 250px;
        }
        .movie-card img {
            max-width: 200px;
            height: 300px;
            object-fit: cover;
            border-radius: 4px;
            display: block;
            margin: 0 auto;
        }
        .movie-card h3 {
            margin: 10px 0 5px;
        }
        .movie-card p {
            margin: 4px 0;
            font-size: 14px;
            color: #444;
        }
    </style>
</head>
<body>
    <header>
        <h1>Cinema Movies</h1>
        <nav>
            <a href="/movies">Movies</a> | 
            <a href="/movies/new">Add Movie</a>
        </nav>
    </header>

    <main>
        <h2>Now Showing</h2>
        <div class="movie-list">
            <div class="movie-card">
                <img src="/images/movie1.jpg" alt="Jurassic Park">
                <h3>Jurassic Park</h3>
                <p>Director: Steven Spielberg</p>
                <p>Genre: Adventure / Sci-Fi</p>
            </div>
            <div class="movie-card">
                <img src="/images/movie2.jpg" alt="The Batman">
                <h3>The Batman</h3>
                <p>Director: Matt Reeves</p>
                <p>Genre: Action / Crime / Drama</p>
            </div>
            <div class="movie-card">
                <img src="/images/movie3.jpg" alt="The Avengers">
                <h3>The Avengers</h3>
                <p>Director: Joss Whedon</p>
                <p>Genre: Action / Sci-Fi</p>
            </div>
        </div>
    </main>
</body>
</html>