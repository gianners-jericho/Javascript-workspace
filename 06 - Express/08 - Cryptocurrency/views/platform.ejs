<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finance Platforms</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body data-endpoint="/api/platforms">

    <header>
        <div>
            <h1>Finance Platforms</h1>
            <a href="/exchanges">Exchanges</a>
            <a href="/">Cryptocurrency</a>
        </div>
    </header>

    <div>
        <div id="display-box" class="display-box">
            <% items.forEach(function(item) { %>
                <div><%= item.name %></div>
            <% }); %>
        </div>

        <button id="previous-button" type="button">Previous 10</button>
        <button id="top-button" type="button">Top 100</button>
        <button id="next-button" type="button">Next 10</button>
    </div>

    <script src="script.js"></script>
</body>
</html>