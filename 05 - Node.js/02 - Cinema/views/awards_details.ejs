<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Excellence Award - Details</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f7f8fa;
      color: #1f2937;
      line-height: 1.6;
    }

    .container {
      width: min(900px, 90%);
      margin: 0 auto;
    }

    header {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      padding: 20px 0;
    }

    .header-content {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
      color: #111827;
    }

    nav a {
      color: #6b7280;
      text-decoration: none;
    }

    nav a:hover {
      color: #111827;
    }

    .breadcrumb {
      padding: 30px 0 10px;
    }

    .breadcrumb a {
      color: #2563eb;
      text-decoration: none;
      font-size: 14px;
    }

    .award-detail {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      margin: 20px 0 50px;
      padding: 40px;
    }

    .award-header {
      display: flex;
      align-items: center;
      gap: 24px;
      padding-bottom: 30px;
      border-bottom: 1px solid #e5e7eb;
    }

    .award-icon {
      width: 90px;
      height: 90px;
      flex-shrink: 0;
      border-radius: 50%;
      background: #fff4cc;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 44px;
    }

    .award-header h1 {
      font-size: 34px;
      margin-bottom: 5px;
    }

    .award-year {
      color: #9a6700;
      font-weight: bold;
    }

    .content {
      padding-top: 30px;
    }

    .content h2 {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .content p {
      color: #4b5563;
      margin-bottom: 24px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin: 25px 0 35px;
    }

    .info-box {
      background: #f9fafb;
      border-radius: 8px;
      padding: 18px;
    }

    .info-box span {
      display: block;
      color: #6b7280;
      font-size: 13px;
      margin-bottom: 4px;
    }

    .info-box strong {
      font-size: 16px;
    }

    .back-link {
      display: inline-block;
      margin-top: 10px;
      color: #2563eb;
      text-decoration: none;
      font-weight: bold;
    }

    @media (max-width: 600px) {
      .award-detail {
        padding: 25px;
      }

      .award-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .award-header h1 {
        font-size: 28px;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="container header-content">
      <div class="logo">Awards Portal</div>

      <nav>
        <a href="awards">Awards</a>
      </nav>
    </div>
  </header>

  <main class="container">

    <div class="breadcrumb">
      <a href="/awards">← Back to all awards</a>
    </div>

    <article class="award-detail">

      <div class="award-header">
        <div class="award-icon"><%= award.icon %></div>

        <div>
          <h1><%= award.name %></h1>
        </div>
      </div>

      <div class="content">

        <div class="info-grid">
          <div class="info-box">
            <span>Award Date</span>
            <strong><%= award.date %></strong>
          </div>

          <div class="info-box">
            <span>Awarded By</span>
            <strong><%= award.awarded_by %></strong>
          </div>

          <div class="info-box">
            <span>Technologies</span>
            <% for (const i in award.technologies) { %>
            <strong><%= award.technologies[i] %></strong>
            <% } %>
          </div>
        </div>

        <a class="back-link" href="/awards">
          ← View all awards
        </a>

      </div>

    </article>

  </main>

</body>
</html>
