<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>Feedback Form</h1>

    <form action="" method="">
      <label for="name">Your Name (Optional):</label>
      <input type="text" id="name" name="name" />

      <br /><br />

      <label for="course">Course Title:</label>
      <select id="course" name="course" required>
        <option value="">Select a course</option>
        <option value="web-development">Web Development</option>
        <option value="database-systems">Database Systems</option>
        <option value="software-engineering">Software Engineering</option>
        <option value="machine-learning">Machine Learning</option>
        <option value="data-structures">Data Structures</option>
      </select>

      <br /><br />

      <label for="score">Score:</label>
      <select id="score" name="score" required>
        <option value="">Select a score</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
        <option value="7">7</option>
        <option value="8">8</option>
        <option value="9">9</option>
        <option value="10">10</option>
      </select>

      <br /><br />

      <label for="reason">Reason:</label>
      <br />
      <textarea
        id="reason"
        name="reason"
        rows="5"
        cols="40"
        required
      ></textarea>

      <br /><br />

      <button type="submit">Submit</button>
    </form>

    <p id="message"></p>

    <p id="random-number"></p>

    <script src="/socket.io/socket.io.js"></script>

    <script>
      // To invoke the socket connection
      const socket = io();
      // A variable for the form
      const form = document.querySelector("form");

      // Form logic when the submit button gets clicked
      form.addEventListener("submit", function (event) {
        // To stop the form from doing its default function
        event.preventDefault();

        // Getting the values from inside the form 
        const name = document.querySelector("#name").value;
        const course = document.querySelector("#course").value;
        const score = document.querySelector("#score").value;
        const reason = document.querySelector("#reason").value;

        // Socket for emitting form information 
        socket.emit("posting_form", {
          name: name,
          course: course,
          score: score,
          reason: reason,
        });
      });

      // Socket for listening on the message of updated_message
      socket.on("updated_message", function (message) {
        document.querySelector("#message").textContent = message;
      });

      // Socket for listening on the random_number of id_number
      socket.on("id_number", function (random_number) {
        document.querySelector("#random-number").textContent = random_number;
      });
    </script>
  </body>
</html>
