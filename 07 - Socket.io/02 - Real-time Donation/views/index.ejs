<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donation Drive</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
        }
        .container {
            width: 500px;
            margin: 0 auto;
            border: 2px solid #000;
            padding: 30px;
            box-shadow: 4px 4px 0px #000;
        }
        .subtitle {
            font-style: italic;
            margin-bottom: 25px;
        }
        .button-group {
            margin-bottom: 25px;
        }
        button {
            padding: 10px 20px;
            font-size: 16px;
            font-weight: bold;
            color: white;
            border: 2px solid #000;
            cursor: pointer;
            margin: 0 10px;
            box-shadow: 2px 2px 0px #000;
        }
        #donate-btn {
            background-color: #28a745;
        }
        #redeem-btn {
            background-color: #dc3545;
        }
        #message-box {
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            color: #856404;
            padding: 10px;
            border-radius: 4px;
            display: none;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- Main heading updated dynamically via client.js -->
        <h1 id="cash-heading">Total Cash Donation: $100</h1>
        
        <p class="subtitle">
            Give according to one's capacity;<br>
            Take according to one's need
        </p>

        <div class="button-group">
            <button id="donate-btn">Donate $10</button>
            <button id="redeem-btn">Redeem $10</button>
        </div>

        <div id="message-box"></div>
    </div>

    <!-- Socket.io client script served automatically by socket.io -->
    <script src="/socket.io/socket.io.js"></script>
    <!-- external static JS script -->
    <script src="/client.js"></script>
</body>
</html>