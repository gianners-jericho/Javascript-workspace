<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Broadcast Example</title>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            color: #111;
            background: white;
        }

        .game-container {
            width: min(100% - 48px, 650px);
            margin: 0 auto;
            padding: 24px 0 48px;
            text-align: center;
        }

        h1 {
            margin: 0 0 26px;
            font-size: 30px;
        }

        .word {
            margin: 0 0 28px;
            font-size: 38px;
            letter-spacing: 12px;
        }

        .chat-board {
            min-height: 260px;
            padding: 14px;
            border: 3px solid #111;
            text-align: left;
            font-size: 22px;
            line-height: 1.35;
        }

        .chat-message {
            margin: 0;
        }

        .winner-message {
            color: #159b31;
            font-style: italic;
        }

        .guess-form {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 18px;
            margin-top: 16px;
        }

        .guess-input {
            box-sizing: border-box;
            width: 100%;
            padding: 10px;
            font-size: 20px;
        }

        .submit-button {
            padding: 8px 16px;
            color: #111;
            background: white;
            font-size: 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <main class="game-container">
        <h1>Guess the Word:</h1>
        <p class="word">s _ _ _ e _</p>

        <section class="chat-board" aria-label="Chat messages" id="chat-board">
            <p class="chat-message" id="user-guess"></p>
        </section>

        <form class="guess-field" id="guess-field">
            <input class="guess-input" type="text" placeholder="enter your guess word here" id="word">
            <button class="submit-button" type="submit">Submit</button>
        </form>
    </main>
    <script src="https://cdn.socket.io/4.8.3/socket.io.min.js"></script>
    <script>
        const socket = io();

        // Ask user to enter their name
        let name = prompt('Enter your name: ');
        if (name === null) {
            name = 'Anonymous';
        }
        //Emitter: send the name to server
        socket.emit('submitName', name);

        document.getElementById('guess-field').addEventListener('submit', function (event) {
            event.preventDefault();

            const input = document.getElementById('word')
            const guess = input.value;

            //Emitter: send the guess word to server
            socket.emit('submitBtn', guess);

            input.value = '';
        });

        //Listener: wait for the users guess with their name
        socket.on('update', function (data) {
            //get the messages container
            const chatBoard = document.getElementById('chat-board');
            
            chatBoard.innerHTML = '';

            // interate and write all the guesses of the user with their name.
            for (let i = 0; i < data.list.length; i++) {
                const entry = data.list[i];
                const message = document.createElement('p');

                message.innerHTML = `${entry.name}: ${entry.guess}`;

                chatBoard.appendChild(message);
            }
        });
    </script>
</body>
</html>