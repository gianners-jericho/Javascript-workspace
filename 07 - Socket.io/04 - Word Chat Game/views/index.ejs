<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Word Chat Game</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .container {
            width: 500px;
            text-align: center;
        }
        h2 {
            margin-bottom: 10px;
        }
        #word-display {
            font-size: 32px;
            font-weight: bold;
            letter-spacing: 5px;
            margin-bottom: 25px;
        }
        #chat-box {
            width: 100%;
            height: 250px;
            border: 2px solid #000;
            padding: 15px;
            box-sizing: border-box;
            overflow-y: auto;
            text-align: left;
            background-color: #fff;
            margin-bottom: 15px;
            box-shadow: 3px 3px 0px #000;
        }
        #chat-box p {
            margin: 4px 0;
            line-height: 1.4;
        }
        #chat-form {
            display: flex;
            gap: 10px;
        }
        #message-input {
            flex-grow: 1;
            padding: 10px;
            font-size: 16px;
            border: 2px solid #000;
            box-shadow: 2px 2px 0px #000;
        }
        button {
            padding: 10px 20px;
            font-size: 16px;
            font-weight: bold;
            border: 2px solid #000;
            background-color: #e0e0e0;
            cursor: pointer;
            box-shadow: 2px 2px 0px #000;
        }
        button:active {
            transform: translate(1px, 1px);
            box-shadow: 1px 1px 0px #000;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>Guess the Word:</h2>
        <!-- Displays the word prompt like "s _ _ _ e _" -->
        <div id="word-display">_ _ _ _ _ _</div>

        <!-- Scrollable chat history box -->
        <div id="chat-box"></div>

        <!-- Form for entering chat messages / word guesses -->
        <form id="chat-form">
            <input type="text" id="message-input" placeholder="enter your guess word here" autocomplete="off" required />
            <button type="submit">Submit</button>
        </form>
    </div>

    <!-- Socket.io client library served automatically -->
    <script src="/socket.io/socket.io.js"></script>
    <!-- External client JavaScript -->
    <script src="/client.js"></script>
</body>
</html>