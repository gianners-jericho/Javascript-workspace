<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Word Chat Game</title>
    <link rel="stylesheet" href="/styles/style.css">
    <script defer src="/socket.io/socket.io.js"></script>
    <script defer src="/scripts/index.js"></script>
</head>
<body>
    <div id="chat-container">
        <h2>Word Chat Game</h2>
        <div id="clue-box">Word: <span id="word-clue">Loading clue...</span></div>
        <div id="chat-box"></div>
        <form id="chat-form">
            <input type="text" id="message-input" placeholder="Type a message or word guess..." autocomplete="off" required>
            <button type="submit">Send</button>
        </form>
    </div>
</body>
</html>
