<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virtual Recitation</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 40px;
        }
        #raise-btn {
            padding: 12px 24px;
            font-size: 18px;
            font-weight: bold;
            color: white;
            background-color: #008a00;
            border: 2px solid #000;
            cursor: pointer;
            box-shadow: 3px 3px 0px #000;
            margin-bottom: 30px;
        }
        #raise-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 1px 1px 0px #000;
        }
        #log-container {
            width: 500px;
            margin: 0 auto;
            text-align: left;
            font-size: 16px;
            line-height: 1.6;
        }
        .socket-id {
            font-weight: bold;
        }
    </style>
</head>
<body>

    <button id="raise-btn">Raise Hand</button>

    <div id="log-container"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/client.js"></script>
</body>
</html>