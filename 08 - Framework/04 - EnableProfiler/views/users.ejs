<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <link rel="stylesheet" href="style.css">
        <title>Users</title>
    </head>
    <body>
        <div class="box">
            <h1>Users (<%= users.length %>)</h1>

            <!-- One row per user -->
            <% users.forEach(function(user) { %>
                <p><%= user.first_name %> <%= user.last_name %> - <%= user.email %></p>
            <% }) %>

            <a href="/logoff">Logoff</a>
        </div>
    </body>
</html>
