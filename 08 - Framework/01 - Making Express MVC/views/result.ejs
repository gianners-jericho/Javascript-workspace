<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Submitted Entry</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="card">
        <h1>Submitted Entry</h1>
        <p><strong>Your Name (optional):</strong> <%= entry.name %></p>
        <p><strong>Course Title:</strong> <%= entry.course_title %></p>
        <p><strong>Given Score (1-10):</strong> <%= entry.score %>pts</p>
        <p><strong>Reason:</strong> <%= entry.reason %></p>
        
        <br>
        <a href="/"><button>Return</button></a>
    </div>
</body>
</html>