<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create your account</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Work+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="auth-page">
    <div class="card">
      <p class="mark">Ledger</p>
      <h1>Open your account</h1>
      <p class="subtitle">Takes less than a minute.</p>

      <% if (typeof error !== "undefined" && error) { %>
      <div class="error-banner"><%= error %></div>
      <% } %>

      <form action="/register" method="POST">
        <div class="field">
          <label for="name">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Jane Cooper"
            value="<%= typeof name !== 'undefined' ? name : '' %>"
            required
          />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            value="<%= typeof email !== 'undefined' ? email : '' %>"
            required
          />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            minlength="8"
            required
          />
          <p class="hint">At least 8 characters.</p>
        </div>
        <div class="field">
          <label for="confirm">Confirm password</label>
          <input
            type="password"
            id="confirm"
            name="confirm"
            placeholder="••••••••"
            minlength="8"
            required
          />
        </div>
        <button type="submit" class="primary">Create account</button>
      </form>

      <p class="foot">Already have an account? <a href="/login">Sign in</a></p>
    </div>
  </div>
</body>
</html>
