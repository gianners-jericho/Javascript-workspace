<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sports Player Lookup</title>
  <style>
    .container { display: flex; gap: 20px; font-family: sans-serif; padding: 20px; }
    .sidebar { width: 250px; border-right: 2px solid #ccc; padding-right: 20px; }
    .results-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; flex-grow: 1; }
    .player-card { border: 1px solid #ddd; padding: 10px; text-align: center; border-radius: 6px; }
    .player-card img { width: 100%; height: 120px; object-fit: cover; }
  </style>
</head>
<body>

  <div class="container">
    <!-- Search / Filter Sidebar -->
    <div class="sidebar">
      <h3>Search Users</h3>
      <form id="search-form">
        <input type="text" name="name" id="name-input" placeholder="Search name..." style="width: 100%; margin-bottom: 15px;">

        <div>
          <label><input type="checkbox" name="gender" value="Female" checked> Female</label><br>
          <label><input type="checkbox" name="gender" value="Male" checked> Male</label>
        </div>

        <h4 style="margin-top: 15px;">Sports</h4>
        <div>
          <label><input type="checkbox" name="sports" value="Basketball" checked> Basketball</label><br>
          <label><input type="checkbox" name="sports" value="Volleyball" checked> Volleyball</label><br>
          <label><input type="checkbox" name="sports" value="Baseball" checked> Baseball</label><br>
          <label><input type="checkbox" name="sports" value="Soccer" checked> Soccer</label><br>
          <label><input type="checkbox" name="sports" value="Football" checked> Football</label><br>
          <label><input type="checkbox" name="sports" value="Tennis" checked> Tennis</label>
        </div>
      </form>
    </div>

    <!-- AJAX Target Container -->
    <div id="player-results" class="results-grid">
      <%- include('partials/playerCards', { players }) %>
    </div>
  </div>

  <!-- Client-side AJAX Script -->
  <script>
    const form = document.getElementById('search-form');
    const resultsContainer = document.getElementById('player-results');

    // Function to fetch partial HTML via fetch API
    async function fetchPlayers() {
      const formData = new FormData(form);
      const params = new URLSearchParams(formData).toString();

      const response = await fetch(`/search?${params}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      const html = await response.text();
      resultsContainer.innerHTML = html;
    }

    // Trigger on keyup for name field & change for checkboxes
    form.addEventListener('input', fetchPlayers);
  </script>

</body>
</html>