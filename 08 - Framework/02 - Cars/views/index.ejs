<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cars</title>
</head>
<body>
    
    <!-- For showing the count of cars in the database -->
    <p>You have <u><%= count.count %></u> cars!</p>

    <!-- For showing the cars in the database -->
    <p>The cars in the database are as follows:</p>
    <ul>
        <% for(let i = 0; i < cars.length; i++) { %>
            <li><%= cars[i].name %> - <%= cars[i].year %></li>
        <% } %>
    </ul>
</body>
</html>