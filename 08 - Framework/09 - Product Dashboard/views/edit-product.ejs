<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Product</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/admin-nav') %>

  <main class="page">
    <div class="page-header">
      <div>
        <h1>Edit product</h1>
        <p class="text-muted">Update the details for this product.</p>
      </div>
      <a href="/admin/dashboard" class="btn btn-secondary">Back to products</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
      <form action="/admin/products/<%= product.id %>/edit" method="POST">
        <div class="form-group">
          <label for="name">Product name</label>
          <input type="text" id="name" name="name" value="<%= product.name %>" required>
        </div>

        <div class="form-group">
          <label for="inventoryCount">Inventory count</label>
          <input type="number" id="inventoryCount" name="inventoryCount" min="0" value="<%= product.inventoryCount %>" required>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" required><%= product.description %></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save changes</button>
        <a href="/admin/dashboard" class="btn btn-secondary">Cancel</a>
      </form>
    </div>
  </main>

</body>
</html>
