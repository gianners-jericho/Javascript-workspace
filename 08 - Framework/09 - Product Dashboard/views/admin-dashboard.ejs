<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/admin-nav') %>

  <main class="page">
    <div class="page-header">
      <div>
        <h1>Products</h1>
        <p class="text-muted">Manage your product catalog.</p>
      </div>
      <a href="/admin/products/new" class="btn btn-primary">Add product</a>
    </div>

    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-success"><%= message %></div>
    <% } %>

    <% if (typeof products !== 'undefined' && products.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Inventory count</th>
            <th>Quantity sold</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(product) { %>
            <tr>
              <td><%= product.id %></td>
              <td><%= product.name %></td>
              <td>
                <%= product.inventoryCount %>
                <% if (product.inventoryCount <= 5) { %>
                  <span class="badge low">Low</span>
                <% } %>
              </td>
              <td><%= product.quantitySold %></td>
              <td>
                <div class="actions-cell">
                  <a href="/admin/products/<%= product.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                  <form action="/admin/products/<%= product.id %>/delete" method="POST" onsubmit="return confirm('Remove this product?');">
                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="card empty-state">
        <p>No products yet. Add your first product to get started.</p>
        <a href="/admin/products/new" class="btn btn-primary">Add product</a>
      </div>
    <% } %>
  </main>

</body>
</html>
