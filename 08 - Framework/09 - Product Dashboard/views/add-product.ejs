<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Product</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/admin-nav') %>

  <main class="page">
    <div class="page-header">
      <div>
        <h1>Add product</h1>
        <p class="text-muted">Fill in the details for the new product.</p>
      </div>
      <a href="/admin/dashboard" class="btn btn-secondary">Back to products</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
      <form action="/admin/products" method="POST">
        <div class="form-group">
          <label for="name">Product name</label>
          <input type="text" id="name" name="name" placeholder="e.g. Wireless Mouse" required>
        </div>

        <div class="form-group">
          <label for="inventoryCount">Inventory count</label>
          <input type="number" id="inventoryCount" name="inventoryCount" min="0" placeholder="0" required>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" placeholder="Short description of the product..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Save product</button>
        <a href="/admin/dashboard" class="btn btn-secondary">Cancel</a>
      </form>
    </div>
  </main>

</body>
</html>
